rules_version = '2';

// Règles de sécurité TCC TV (version 7 : trophées, Slammy, bannière du profil, images des fiches catcheurs, Babies du mois).
// (version 6 : sondages, pronostics, réactions et réponses, idées ; version 5 : réglages des discussions, notes des combats ; version 4 : suppression du compte ;
//  version 3 : commentaires, likes, notifications, activité, images et GIFs dans le chat)
// À coller en entier dans Firebase > Firestore Database > Règles, puis « Publier ».
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.uid == "gYOlkXsJc3WedSykoBNyeWg2ELx1"; }
    function str(v, max) { return v is string && v.size() <= max; }
    function okText(v) { return v is string && v.size() > 0 && v.size() <= 1000; }
    // message du chat : texte, et/ou image compressée, et/ou GIF (lien https)
    function okMsg(d) {
      return d.keys().hasOnly(['uid','text','at','img','gif'])
        && d.uid == request.auth.uid && d.at == request.time
        && d.text is string && d.text.size() <= 1000
        && (!('img' in d) || (d.img is string && d.img.size() > 30 && d.img.size() < 950000))
        && (!('gif' in d) || (d.gif is string && d.gif.size() > 10 && d.gif.size() <= 600 && d.gif.matches('https://.*')))
        && (d.text.size() > 0 || 'img' in d || 'gif' in d);
    }
    // paire « uidA_uidB » (triée) : en fait-on partie, et qui est l'autre ?
    function inPairId(p) { return signedIn() && request.auth.uid in p.split('_'); }
    function otherIn(p) { return p.split('_')[0] == request.auth.uid ? p.split('_')[1] : p.split('_')[0]; }
    function okPair(p, m) { return m is list && m.size() == 2 && m[0] < m[1] && p == m[0] + '_' + m[1]; }
    // l'autre membre m'a-t-il bloqué ?
    function blockedBy(u) {
      return exists(/databases/$(database)/documents/blocks/$(u))
        && request.auth.uid in get(/databases/$(database)/documents/blocks/$(u)).data.list;
    }

    // ---------- Profils (visibles par les membres connectés) ----------
    match /users/{uid} {
      function okProfile(d) {
        return d.keys().hasOnly(['pseudo','pseudoLower','bio','favShow','favWrestler','favWrestlerF','photo','createdAt','favs','tro'])
          && str(d.pseudo, 30) && d.pseudo.size() > 0 && str(d.pseudoLower, 30)
          && str(d.bio, 300) && str(d.favShow, 60) && str(d.favWrestler, 40) && str(d.favWrestlerF, 40)
          && str(d.photo, 400000)
          && (!('favs' in d) || (d.favs is list && d.favs.size() <= 30))
          && (!('tro' in d) || (d.tro is map && d.tro.size() <= 60));
      }
      allow read: if signedIn();
      allow create: if isMe(uid) && okProfile(request.resource.data) && request.resource.data.createdAt == request.time;
      allow update: if isMe(uid) && okProfile(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isMe(uid);

      // Historique « déjà vu » + notes (visible par les membres, modifiable par soi seulement)
      match /history/{itemId} {
        allow read: if signedIn();
        allow create, update: if isMe(uid)
          && request.resource.data.keys().hasOnly(['title','k','show','d','rating','comment','seenAt'])
          && str(request.resource.data.title, 150) && str(request.resource.data.k, 30)
          && str(request.resource.data.show, 40) && str(request.resource.data.d, 10)
          && request.resource.data.rating is int && request.resource.data.rating >= 0 && request.resource.data.rating <= 5
          && (!('comment' in request.resource.data) || str(request.resource.data.comment, 300))
          && request.resource.data.seenAt == request.time;
        allow delete: if isMe(uid);
      }
    }

    // ---------- Messages lus (privé) ----------
    match /reads/{uid} {
      allow read, write: if isMe(uid);
    }

    // ---------- Images des vignettes : tout le monde voit, seul l'admin modifie ----------
    match /images/{imageId} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.data.src is string && request.resource.data.src.size() < 900000;
      allow delete: if isAdmin();
    }

    // ---------- Salon commun ----------
    match /rooms/{room}/messages/{msgId} {
      allow read: if signedIn();
      allow create: if signedIn() && room == 'general' && okMsg(request.resource.data);
      allow update: if false;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // ---------- Messages privés ----------
    match /dms/{pairId} {
      function inPair() { return signedIn() && request.auth.uid in pairId.split('_'); }
      allow get: if inPair();
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if inPair()
        && request.resource.data.members is list && request.resource.data.members.size() == 2
        && pairId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && request.resource.data.members[0] < request.resource.data.members[1];
      // dernier message, non lus, et réglages partagés : couleur, emoji rapide, surnoms, « Vu » (chacun ne change que son propre « Vu »)
      allow update: if inPair()
        && request.resource.data.members == resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last','updatedAt','unread','theme','emoji','nicks','seen'])
        && (!('theme' in request.resource.data) || str(request.resource.data.theme, 20))
        && (!('emoji' in request.resource.data) || str(request.resource.data.emoji, 16))
        && (!('nicks' in request.resource.data) || (request.resource.data.nicks is map && request.resource.data.nicks.size() <= 2))
        && (!('seen' in request.resource.data) || (request.resource.data.seen is map && request.resource.data.seen.size() <= 2
            && request.resource.data.seen.get(otherIn(pairId), null) == resource.data.get('seen', {}).get(otherIn(pairId), null)));
      allow delete: if false;

      match /messages/{msgId} {
        allow read: if signedIn() && request.auth.uid in pairId.split('_');
        allow create: if signedIn() && request.auth.uid in pairId.split('_')
          && exists(/databases/$(database)/documents/dms/$(pairId))
          && !blockedBy(otherIn(pairId))
          && okMsg(request.resource.data);
        allow update: if false;
        allow delete: if isAdmin() || (inPairId(pairId) && resource.data.uid == request.auth.uid);
      }
    }

    // ---------- Amis : demande -> acceptée (visible par les membres connectés) ----------
    match /friends/{pairId} {
      allow read: if signedIn();
      allow create: if inPairId(pairId) && okPair(pairId, request.resource.data.members)
        && request.resource.data.keys().hasOnly(['members','from','status','at'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.at == request.time
        && !blockedBy(otherIn(pairId));
      allow update: if inPairId(pairId) && resource.data.status == 'pending'
        && request.auth.uid != resource.data.from
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','okAt'])
        && request.resource.data.status == 'ok' && request.resource.data.okAt == request.time;
      allow delete: if inPairId(pairId);
    }

    // ---------- Feuds (compteur de jours d'affilée, visible par les deux membres) ----------
    match /feuds/{pairId} {
      function okFeud(d) {
        return d.count is int && d.count >= 0 && d.best is int && d.best >= d.count
          && str(d.countDay, 10) && d.days is map && d.days.size() <= 2
          && str(d.days.get(request.auth.uid, ''), 10) && d.updatedAt == request.time;
      }
      allow get: if inPairId(pairId);
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if inPairId(pairId) && okPair(pairId, request.resource.data.members)
        && request.resource.data.keys().hasOnly(['members','days','count','countDay','best','updatedAt'])
        && request.resource.data.days.keys().hasOnly([request.auth.uid])
        && request.resource.data.count == 0 && okFeud(request.resource.data)
        && !blockedBy(otherIn(pairId));
      allow update: if inPairId(pairId)
        && request.resource.data.members == resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['days','count','countDay','best','updatedAt'])
        && request.resource.data.days.get(otherIn(pairId), '') == resource.data.days.get(otherIn(pairId), '')
        && request.resource.data.days.keys().hasOnly([request.auth.uid, otherIn(pairId)])
        && request.resource.data.count <= resource.data.count + 1
        && okFeud(request.resource.data)
        && !blockedBy(otherIn(pairId));
      allow delete: if inPairId(pairId);
    }

    // ---------- Membres bloqués (liste privée) ----------
    match /blocks/{uid} {
      allow read, delete: if isMe(uid);
      allow create, update: if isMe(uid) && request.resource.data.keys().hasOnly(['list'])
        && request.resource.data.list is list && request.resource.data.list.size() <= 500;
    }

    // ---------- Signalements : n'importe quel membre signale, seul l'admin lit ----------
    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.by == request.auth.uid
        && request.resource.data.keys().hasOnly(['by','target','reason','text','conv','msg','msgText','at'])
        && str(request.resource.data.target, 60) && str(request.resource.data.reason, 40) && str(request.resource.data.text, 500)
        && str(request.resource.data.conv, 140) && str(request.resource.data.msg, 60) && str(request.resource.data.msgText, 1000)
        && request.resource.data.at == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // ---------- Commentaires des fiches catcheurs : tout le monde lit, likes et réponses ----------
    match /wcomments/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['w','name','uid','text','parent','likes','at'])
        && request.resource.data.uid == request.auth.uid
        && str(request.resource.data.w, 80) && request.resource.data.w.size() > 0 && str(request.resource.data.name, 60)
        && okText(request.resource.data.text) && request.resource.data.text.size() <= 500
        && str(request.resource.data.parent, 40)
        && request.resource.data.likes is list && request.resource.data.likes.size() == 0
        && request.resource.data.at == request.time;
      // liker / ne plus liker : on ne peut ajouter ou retirer que soi-même
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
        && request.resource.data.likes is list && request.resource.data.likes.size() <= 2000
        && request.resource.data.likes.toSet().difference(resource.data.likes.toSet()).hasOnly([request.auth.uid])
        && resource.data.likes.toSet().difference(request.resource.data.likes.toSet()).hasOnly([request.auth.uid]);
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // ---------- Notifications (like, réponse, réaction) : n'importe quel membre en envoie, seul le destinataire les lit ----------
    match /notifs/{uid}/items/{id} {
      allow read, delete: if isMe(uid);
      allow create, update: if signedIn() && uid != request.auth.uid
        && request.resource.data.keys().hasOnly(['type','from','w','name','cid','text','a','at'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.type in ['like','reply','areply','areact','slammy']
        && str(request.resource.data.get('w', ''), 80) && str(request.resource.data.name, 60)
        && str(request.resource.data.get('cid', ''), 40) && str(request.resource.data.text, 160)
        && str(request.resource.data.get('a', ''), 300)
        && request.resource.data.at == request.time;
    }

    // ---------- Activité des membres (notes et commentaires), visible par les membres connectés ----------
    // l'auteur écrit sa note ; les autres membres ne peuvent qu'ajouter / retirer LEUR réaction (rx) et compter les réponses (rn)
    match /activity/{id} {
      function okAct(d) {
        return d.keys().hasOnly(['uid','kind','k','show','d','title','rating','comment','w','name','at','rx','rn'])
          && d.uid == request.auth.uid
          && d.kind in ['rate','wcom','mrate','trophy','slammy','babies']
          && str(d.k, 30) && str(d.show, 40) && str(d.d, 10)
          && str(d.title, 150) && d.rating is int && d.rating >= 0 && d.rating <= 5
          && str(d.comment, 500) && str(d.w, 80) && str(d.name, 60)
          && d.at == request.time;
      }
      allow read: if signedIn();
      allow create: if signedIn() && id.split('_')[0] == request.auth.uid && okAct(request.resource.data)
        && !('rx' in request.resource.data) && !('rn' in request.resource.data);
      allow update: if
        // l'auteur modifie sa note (sans toucher aux réactions ni au nombre de réponses)
        (signedIn() && id.split('_')[0] == request.auth.uid && okAct(request.resource.data)
          && request.resource.data.get('rx', {}) == resource.data.get('rx', {})
          && request.resource.data.get('rn', 0) == resource.data.get('rn', 0))
        // un membre ajoute, change ou retire sa propre réaction
        || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rx'])
          && request.resource.data.rx is map && request.resource.data.rx.size() <= 500
          && request.resource.data.rx.diff(resource.data.get('rx', {})).affectedKeys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in request.resource.data.rx) || str(request.resource.data.rx[request.auth.uid], 8)))
        // une réponse ajoutée (+1) ou supprimée (-1)
        || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rn'])
          && request.resource.data.rn is int && request.resource.data.rn >= 0
          && (request.resource.data.rn == resource.data.get('rn', 0) + 1 || request.resource.data.rn == resource.data.get('rn', 0) - 1));
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // ---------- Réponses sous une note ou un commentaire ----------
    match /areplies/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['a','uid','text','at'])
        && request.resource.data.uid == request.auth.uid
        && str(request.resource.data.a, 300) && request.resource.data.a.size() > 0
        && okText(request.resource.data.text) && request.resource.data.text.size() <= 300
        && request.resource.data.at == request.time;
      allow update: if false;
      // l'auteur de la réponse, l'auteur de la note (début de l'identifiant de l'activité) ou l'admin
      allow delete: if isAdmin() || (signedIn() && (resource.data.uid == request.auth.uid || resource.data.a.split('_')[0] == request.auth.uid));
    }

    // ---------- Sondages : l'admin crée, clôt et supprime ; les membres votent (un vote chacun, modifiable) ----------
    match /polls/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /pollvotes/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['poll','uid','c','o','at'])
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.poll + '_' + request.auth.uid
        && str(request.resource.data.poll, 100)
        && request.resource.data.c is int && request.resource.data.c >= -1 && request.resource.data.c <= 5
        && str(request.resource.data.o, 40)
        && request.resource.data.at == request.time;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // ---------- Pronostics : chacun les siens, fermés au début du show ----------
    match /picks/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && id.split('_')[0] == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','ev','k','d','t','p','at'])
        && request.resource.data.uid == request.auth.uid
        && str(request.resource.data.ev, 120) && str(request.resource.data.k, 30) && str(request.resource.data.d, 10)
        && request.resource.data.t is number && request.time.toMillis() < request.resource.data.t
        && request.resource.data.p is map && request.resource.data.p.size() <= 20
        && request.resource.data.at == request.time;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ---------- « Partagez vos idées » : les membres proposent et votent, l'admin donne un statut ----------
    match /ideas/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid','text','votes','st','at'])
        && request.resource.data.uid == request.auth.uid
        && okText(request.resource.data.text) && request.resource.data.text.size() <= 500
        && request.resource.data.votes is list && request.resource.data.votes.size() == 0
        && request.resource.data.st == ''
        && request.resource.data.at == request.time;
      allow update: if
        // voter / retirer son vote : on ne peut ajouter ou retirer que soi-même
        (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
          && request.resource.data.votes is list && request.resource.data.votes.size() <= 2000
          && request.resource.data.votes.toSet().difference(resource.data.votes.toSet()).hasOnly([request.auth.uid])
          && resource.data.votes.toSet().difference(request.resource.data.votes.toSet()).hasOnly([request.auth.uid]))
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st'])
          && request.resource.data.st in ['', 'prévu', 'fait', 'refusé']);
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // ---------- Bannière du profil (image compressée, à part pour ne pas alourdir la liste des membres) ----------
    match /banners/{uid} {
      allow read: if signedIn();
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['src','at'])
        && request.resource.data.src is string && request.resource.data.src.size() < 400000
        && request.resource.data.src.matches('data:image/.*')
        && request.resource.data.at == request.time;
      allow delete: if isMe(uid) || isAdmin();
    }

    // ---------- Slammy : trophée spécial remis par l'admin ----------
    match /slammy/{id} {
      allow read: if signedIn();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['uid','n','at'])
        && str(request.resource.data.uid, 60) && str(request.resource.data.n, 60) && request.resource.data.n.size() > 0
        && request.resource.data.at == request.time;
      allow update: if false;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // ---------- Image d'une fiche catcheur : ajoutée par n'importe quel membre, enlevée par l'admin ou par son auteur ----------
    match /wimages/{slug} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['w','name','uid','src','at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.w == slug && str(request.resource.data.name, 60)
        && request.resource.data.src is string
        && ((request.resource.data.src.size() < 400000 && request.resource.data.src.matches('data:image/.*'))
            || (request.resource.data.src.size() <= 600 && request.resource.data.src.matches('https://.*')))
        && request.resource.data.at == request.time;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // ---------- Hall of Fame (gagnantes de la Babies du mois) : enregistré par l'admin ----------
    match /hof/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---------- Catcheurs suivis (favoris de tous les membres, pour la mise à jour quotidienne) ----------
    match /followed/{id} {
      allow read: if true;
      allow write: if signedIn() && id == 'list' && request.resource.data.keys().hasOnly(['names'])
        && request.resource.data.names is list && request.resource.data.names.size() <= 1000;
    }
  }
}
